<Window x:Class="LibraryManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Management"
        Height="450"
        Width="800"
        Background="White">

    <Window.Resources>

        <Style x:Key="AddButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Blue"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="OtherButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

    </Window.Resources>

    <StackPanel Margin="30">

        <StackPanel.Resources>

            <Style TargetType="TextBox">
                <Setter Property="Height" Value="30"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="5"/>
                <Setter Property="Padding" Value="5"/>
            </Style>

        </StackPanel.Resources>

        <TextBlock Text="Library Management"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="10"/>

        <Label Content="Book Name"/>

        <TextBox>
            <TextBox.Resources>
                <Style x:Key="BookNameStyle" TargetType="TextBox">
                    <Setter Property="Height" Value="35"/>
                    <Setter Property="Background" Value="LightYellow"/>
                    <Setter Property="BorderBrush" Value="Blue"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Margin" Value="5"/>
                </Style>
            </TextBox.Resources>

            <TextBox.Style>
                <StaticResource ResourceKey="BookNameStyle"/>
            </TextBox.Style>
        </TextBox>

        <Label Content="Author Name"/>

        <TextBox/>

        <Label Content="Book ID"/>

        <TextBox/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="10">

            <Button Content="Add Book"
                    Style="{StaticResource AddButtonStyle}"/>

            <Button Content="Update"
                    Style="{StaticResource OtherButtonStyle}"/>

            <Button Content="Delete"
                    Style="{StaticResource OtherButtonStyle}"/>

        </StackPanel>

    </StackPanel>

</Window>